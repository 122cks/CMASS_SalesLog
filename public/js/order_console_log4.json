  "pageHtml": "<!DOCTYPE html><html lang=\"ko\"><head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <title>Order 현황</title>\n  <style>\n    body{font-family:Segoe UI, Arial, sans-serif;background:linear-gradient(180deg,#0b2540,#08243a);color:#eaf6ff;margin:0;padding:18px}\n    h1{font-size:1.6rem;text-align:center;margin:8px 0 18px}\n    .controls{max-width:1100px;margin:0 auto 12px;display:flex;gap:8px;align-items:center;justify-content:center}\n    select, input[type=text]{padding:8px;border-radius:8px;border:0;background:#0f394f;color:#fff}\n    table{width:100%;max-width:1100px;margin:12px auto;border-collapse:collapse;background:rgba(255,255,255,0.02);border-radius:8px;overflow:hidden}\n    th,td{padding:8px 10px;border-bottom:1px solid rgba(255,255,255,0.04);text-align:left;font-size:0.95rem}\n    thead th{background:linear-gradient(90deg,#063248,#0b4a6a);color:#dff6ff}\n    tbody tr:hover td{background:linear-gradient(180deg,#071e2b,#0b2a36)}\n    .count{font-weight:800;color:#fff}\n    .summary{max-width:1100px;margin:8px auto;color:#cfe7f6}\n    .back{display:block;text-align:center;color:#9fd3c7;margin-top:6px;text-decoration:none}\n    .empty{color:#9fb1c0;text-align:center;padding:18px}\n  </style>\n</head>\n<body>\n  <h1>Order 현황 (CSV)</h1>\n  <div style=\"max-width:1100px;margin:0 auto 12px;text-align:center\"><strong>교지명에 '교과서'가 포함된 항목만 표시합니다</strong></div>\n  <div class=\"summary\"><span id=\"totalCount\">총 항목(교과서): 0</span></div>\n  <table id=\"orderTable\">\n    <thead>\n      <tr><th>학교급</th><th>교과군</th><th>과목명</th><th>정가</th><th>부수</th><th>금액</th><th>내용</th></tr>\n    </thead>\n    <tbody id=\"orderBody\"><tr><td colspan=\"7\" class=\"empty\">표시할 항목이 없습니다</td></tr></tbody>\n  </table>\n  <a class=\"back\" href=\"/dashboard.html\">← 대시보드로 돌아가기</a>\n\n<script>\n// Simple CSV loader and renderer grouped by school\nasync function fetchCsv(url){\n  const res = await fetch(url);\n  if(!res.ok) throw new Error('fetch failed');\n  const txt = await res.text();\n  const lines = txt.split(/\\r?\\n/).filter(Boolean);\n  if(!lines.length) return [];\n  // naive CSV split by comma - works if CSV is simple; handles quoted fields\n  function parseLine(line){\n    const out=[]; let cur=''; let inQuotes=false;\n    for(let i=0;i<line.length;i++){\n      const ch = line[i];\n      if(ch === '\"') { inQuotes = !inQuotes; continue; }\n      if(ch === ',' && !inQuotes){ out.push(cur); cur=''; continue; }\n      cur += ch;\n    }\n    out.push(cur);\n    return out.map(s=> s.trim());\n  }\n  const header = parseLine(lines[0]).map(h=>h.replace(/\\\"/g,'').trim());\n  const rows = [];\n  for(let i=1;i<lines.length;i++){\n    try{ const cols = parseLine(lines[i]); if(cols.length === 0) continue; const obj={}; for(let j=0;j<header.length;j++){ obj[header[j]] = cols[j] || ''; } rows.push(obj); }catch(e){ continue; }\n  }\n  console.log('ORDER_DEBUG header', header.slice(0,10));\n  console.log('ORDER_DEBUG rows_count', rows.length);\n  try{\n    const rawMatches = rows.filter(r=> Object.values(r).join(' ').includes('S020000338')).slice(0,5);\n    console.log('ORDER_DEBUG rawMatches_sample', JSON.stringify(rawMatches,null,2));\n  }catch(e){ console.log('ORDER_DEBUG err', String(e)); }\n  return { header, rows };\n}\n\n// render grouped summary by 교과군 (subjectGroup)\nfunction renderSummary(rows){\n  const div = document.getElementById('summaryDiv');\n  if(!rows || rows.length===0){ div.innerHTML = ''; return; }\n  const groups = new Map();\n  rows.forEach(r=>{\n    const g = (r.subjectGroup || r.subjectName || '기타').trim();\n    if(!groups.has(g)) groups.set(g, { group: g, copies:0, amount:0, rows:[] });\n    const gv = groups.get(g);\n    gv.copies += (r.copiesNum || 0);\n    gv.amount += (r.amountNum || 0);\n    gv.rows.push(r);\n  });\n  const rowsHtml = ['<div style=\"margin-bottom:8px\"><strong>교과군별 합계</strong></div>', '<table style=\"width:100%;max-width:1100px;margin:12px auto;border-collapse:collapse;background:rgba(255,255,255,0.02)\">', '<thead><tr style=\"background:linear-gradient(90deg,#063248,#0b4a6a);color:#dff6ff\"><th>교과군</th><th style=\"text-align:right\">부수합계</th><th style=\"text-align:right\">금액합계</th><th>상세보기</th></tr></thead><tbody>'];\n  Array.from(groups.values()).sort((a,b)=> a.group.localeCompare(b.group)).forEach(gv=>{\n    rowsHtml.push(`<tr><td>${escapeHtml(gv.group)}</td><td style=\"text-align:right\">${gv.copies}</td><td style=\"text-align:right\">${gv.amount.toLocaleString()}</td><td><button data-group=\"${escapeHtml(gv.group)}\" class=\"smallViewBtn\">보기 (${gv.rows.length})</button></td></tr>`);\n  });\n  rowsHtml.push('</tbody></table>');\n  // also build subject-level totals (과목별 합계)\n  const subjectTotals = new Map();\n  rows.forEach(r=>{\n    const subj = (r.subjectName || r.item || '기타').trim();\n    if(!subjectTotals.has(subj)) subjectTotals.set(subj, { subject:subj, copies:0, amount:0, rows:[] });\n    const sv = subjectTotals.get(subj);\n    sv.copies += (r.copiesNum || 0);\n    sv.amount += (r.amountNum || 0);\n    sv.rows.push(r);\n  });\n  const subRows = ['<div style=\"margin-top:12px;margin-bottom:8px\"><strong>과목별 합계</strong></div>', '<table style=\"width:100%;max-width:1100px;margin:12px auto;border-collapse:collapse;background:rgba(255,255,255,0.02)\">', '<thead><tr style=\"background:linear-gradient(90deg,#063248,#0b4a6a);color:#dff6ff\"><th>과목명</th><th style=\"text-align:right\">부수합계</th><th style=\"text-align:right\">금액합계</th><th>보기</th></tr></thead><tbody>'];\n  Array.from(subjectTotals.values()).sort((a,b)=> a.subject.localeCompare(b.subject)).forEach(sv=>{\n    subRows.push(`<tr><td>${escapeHtml(sv.subject)}</td><td style=\"text-align:right\">${sv.copies}</td><td style=\"text-align:right\">${sv.amount.toLocaleString()}</td><td><button data-subject=\"${escapeHtml(sv.subject)}\" class=\"subjectViewBtn\">보기 (${sv.rows.length})</button></td></tr>`);\n  });\n  subRows.push('</tbody></table>');\n  rowsHtml.push(subRows.join(''));\n  div.innerHTML = rowsHtml.join('');\n  Array.from(div.querySelectorAll('.smallViewBtn')).forEach(btn=>{\n    btn.addEventListener('click', function(){ const g = this.dataset.group; const filtered = rows.filter(r=> (r.subjectGroup||r.subjectName||'기타').trim()===g); renderTable(filtered); });\n  });\n  Array.from(div.querySelectorAll('.subjectViewBtn')).forEach(btn=>{\n    btn.addEventListener('click', function(){ const subj = this.dataset.subject; const filtered = rows.filter(r=> (r.subjectName||r.item||'기타').trim()===subj); renderTable(filtered); });\n  });\n}\n\nfunction escapeHtml(s){ return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }\n\nfunction buildSchoolMap(rows, schoolKeyCandidates){\n  const map = new Map();\n  rows.forEach(r=>{\n    // find a school field in the row - try common header names\n    let school = '';\n    for(const k of schoolKeyCandidates){ if(r[k]) { school = r[k]; break; } }\n    school = (school||'').trim();\n    const key = school.toLowerCase() || '__unknown__';\n    if(!map.has(key)) map.set(key, { school: school || '(미상)', items: [] });\n    map.get(key).items.push(r);\n  });\n  return map;\n}\n\nfunction renderTable(filteredRows){\n  const body = document.getElementById('orderBody');\n  if(!filteredRows || filteredRows.length === 0){ body.innerHTML = '<tr><td colspan=\"7\" class=\"empty\">표시할 항목이 없습니다</td></tr>'; return; }\n  // sort by 교과군, then 과목명 for consistent grouping\n  filteredRows.sort((a,b)=>{\n     const ag = String(a.subjectGroup || a['교과군'] || a.subjectName || '').localeCompare(String(b.subjectGroup || b['교과군'] || b.subjectName || ''));\n    if(ag !== 0) return ag;\n    return String(a.subjectName||a['과목명']||'').localeCompare(String(b.subjectName||b['과목명']||''));\n  });\n\n  body.innerHTML = filteredRows.map(r=>{\n    const schoolLevel = escapeHtml(r.schoolLevel || r['학교급'] || r.school || '');\n    const subjectGroup = escapeHtml(r.subjectGroup || r['교과군'] || r.subjectName || '');\n    const subjectName = escapeHtml(r.subjectName || r['과목명'] || '');\n    const price = (r.priceNum!=null)? Number(r.priceNum).toLocaleString() : escapeHtml(r.price || '');\n    const copies = (r.copiesNum!=null)? String(r.copiesNum) : escapeHtml(r.copies || r.qty || '');\n    const amount = (r.amountNum!=null)? Number(r.amountNum).toLocaleString() : escapeHtml(r.amount || '');\n    const note = escapeHtml(r.note || r.Note || r['비고'] || r['remark'] || '');\n     return `<tr><td>${schoolLevel}</td><td>${subjectGroup}</td><td>${subjectName}</td><td style=\"text-align:right\">${price}</td><td style=\"text-align:right\">${copies}</td><td style=\"text-align:right\">${amount}</td><td>${note}</td></tr>`;\n  }).join('');\n}\n\n(async function init(){\n  try{\n    const data = await fetchCsv('/order.csv');\n    const rows = data.rows || [];\n    // detect school column names\n    const header = data.header || [];\n    const schoolCandidates = header.filter(h=> /학교|school|schoolname|학교명/i.test(h));\n    const itemCandidates = header.filter(h=> /품목|상품|item|product/i.test(h));\n    const qtyCandidates = header.filter(h=> /수량|qty|quantity|부수/i.test(h));\n    const statusCandidates = header.filter(h=> /상태|status|진행/i.test(h));\n    const noteCandidates = header.filter(h=> /비고|note|remark/i.test(h));\n    // requested columns\n    const curriculumCandidates = header.filter(h=> /교육과정|curriculum|과정/i.test(h));\n    const bookNameCandidates = header.filter(h=> /교재명|교지명|도서명|bookname|title/i.test(h));\n    const bookCodeCandidates = header.filter(h=> /도서코드|bookcode|code|ISBN/i.test(h));\n    const schoolCodeCandidates = header.filter(h=> /정보공시학교코드|학교코드|school[_ ]?code|schoolid|school_id|code/i.test(h));\n    const subjectGroupCandidates = header.filter(h=> /교과군|계열|과목군|subject ?group/i.test(h));\n    const subjectNameCandidates = header.filter(h=> /과목명|subject|과목/i.test(h));\n    const priceCandidates = header.filter(h=> /정가|가격|price|단가/i.test(h));\n    const copiesCandidates = header.filter(h=> /부수|수량|qty|quantity/i.test(h));\n    const amountCandidates = header.filter(h=> /금액|amount|total/i.test(h));\n    const levelCandidates = header.filter(h=> /학교급|급|school ?level|level|학급/i.test(h));\n\n    // helper: normalize school names for robust matching\n    function normalizeSchool(s){ if(!s) return '__unknown__'; s = String(s).trim().toLowerCase(); // remove common punctuation and whitespace\n      s = s.replace(/\\s+/g,'');\n      s = s.replace(/[\"'`\\.,\\-\\/\\\\()\\[\\]]+/g,'');\n      // remove common Korean school suffixes to normalize (초등학교/중학교/고등학교 등)\n      s = s.replace(/(초등학교|초등|중학교|중등학교|중등|고등학교|고등|학교|학교명)$/g,'');\n      s = s.replace(/\\s+/g,'');\n      return s || '__unknown__'; }\n\n    // normalize rows to unified keys used by renderer\n    const norm = rows.map(r=>{\n      const o = {};\n      // basic fields\n      for(const k of schoolCandidates){ if(r[k]){ o.school = r[k]; break; } }\n      for(const k of itemCandidates){ if(r[k]){ o.item = r[k]; break; } }\n      for(const k of qtyCandidates){ if(r[k]){ o.qty = r[k]; break; } }\n      for(const k of statusCandidates){ if(r[k]){ o.status = r[k]; break; } }\n      for(const k of noteCandidates){ if(r[k]){ o.note = r[k]; break; } }\n      // requested extra fields\n      for(const k of curriculumCandidates){ if(r[k]){ o.curriculum = r[k]; break; } }\n      for(const k of bookNameCandidates){ if(r[k]){ o.bookName = r[k]; break; } }\n      for(const k of bookCodeCandidates){ if(r[k]){ o.bookCode = r[k]; break; } }\n      for(const k of subjectGroupCandidates){ if(r[k]){ o.subjectGroup = r[k]; break; } }\n      for(const k of subjectNameCandidates){ if(r[k]){ o.subjectName = r[k]; break; } }\n      for(const k of levelCandidates){ if(r[k]){ o.schoolLevel = r[k]; break; } }\n      for(const k of priceCandidates){ if(r[k]){ o.price = r[k]; break; } }\n      for(const k of copiesCandidates){ if(r[k]){ o.copies = r[k]; break; } }\n      for(const k of amountCandidates){ if(r[k]){ o.amount = r[k]; break; } }\n      for(const k of schoolCodeCandidates){ if(r[k]){ o.schoolCode = String(r[k]).trim(); break; } }\n\n      // fallback: assign first columns if none matched\n      if(!o.school) o.school = rows.length && (r[header[0]] || '');\n      if(!o.item) o.item = r[header[1]] || '';\n      if(!o.qty && header[2]) o.qty = r[header[2]] || '';\n      if(!o.status && header[3]) o.status = r[header[3]] || '';\n      if(!o.note && header[4]) o.note = r[header[4]] || '';\n\n      // normalized key for matching\n      o.schoolNorm = normalizeSchool(o.school);\n\n      // numeric parsing helper\n      function toNum(v){ if(v==null || v==='') return 0; const n = Number(String(v).replace(/[^0-9.-]+/g,'')); return isNaN(n)?0:n; }\n      o.priceNum = toNum(o.price || r['정가'] || r['price']);\n      o.copiesNum = toNum(o.copies || o.qty || r['부수'] || r['수량']);\n      o.amountNum = toNum(o.amount || r['금액'] || r['amount']);\n\n      return o;\n    });\n\n    // support URL parameter: ?school=<code or name> or ?code=<code>\n    const urlParams = new URLSearchParams(location.search);\n    const schoolParam = (urlParams.get('school') || urlParams.get('code') || '').trim();\n\n    // If a school param is provided, show all rows for that school (helps debugging and direct links).\n    let filtered;\n    if(schoolParam){\n      const param = String(schoolParam).trim();\n      const paramNorm = normalizeSchool(param);\n      filtered = norm.filter(r=>{\n        if(r.schoolCode && String(r.schoolCode).toLowerCase() === param.toLowerCase()) return true;\n        if(r.schoolNorm && r.schoolNorm === paramNorm) return true;\n        const any = Object.values(r).join(' ').toLowerCase();\n        if(any.includes(param.toLowerCase())) return true;\n        return false;\n      });\n    } else {\n      // simple view: show only rows where any cell contains \"교과서\"\n      filtered = norm.filter(r=> {\n        const joined = Object.values(r).join(' ').toLowerCase();\n        return joined.includes('교과서');\n      });\n    }\n\n    const totalCount = document.getElementById('totalCount');\n    console.log('ORDER_DEBUG filtered_length', filtered.length);\n    totalCount.textContent = `총 항목(교과서): ${filtered.length}`;\n    renderTable(filtered);\n  }catch(e){ console.error(e); document.getElementById('orderBody').innerHTML = '<tr><td colspan=\"5\" class=\"empty\">데이터를 불러오지 못했습니다.</td></tr>'; document.getElementById('totalCount').textContent = '에러'; }\n})();\n</script>\n\n</body></html>"
}