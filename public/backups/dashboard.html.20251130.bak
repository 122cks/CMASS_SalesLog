<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>C-MASS_SALES 대시보드</title>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chartjs-chart-matrix@1.2.0/dist/chartjs-chart-matrix.min.js"></script>
  <!-- Firebase client (compat) for dashboard data reads -->
  <script src="https://www.gstatic.com/firebasejs/9.22.1/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/9.22.1/firebase-firestore-compat.js"></script>
  <script>
    // Initialize Firebase (same config as front page)
    try{
      const firebaseConfig = {
        apiKey: "AIzaSyARdXNfFCUShNeFXV8cTDzFbKa4GId5EvU",
        authDomain: "cmass-sales.firebaseapp.com",
        projectId: "cmass-sales",
        storageBucket: "cmass-sales.firebasestorage.app",
        messagingSenderId: "918981476485",
        appId: "1:918981476485:web:7939150e23500e2703a9ec",
        measurementId: "G-9188JJXRWX"
      };
      try{ firebase.initializeApp(firebaseConfig); window.__db = firebase.firestore(); }catch(e){}
      window.waitForFirebase = function(){ return new Promise((resolve,reject)=>{ if(window.__db) return resolve(); let attempts=0; const t=setInterval(()=>{ attempts++; if(window.__db){ clearInterval(t); resolve(); } if(attempts>50){ clearInterval(t); reject(new Error('firebase init timeout')); } },100); }); };
    }catch(e){}
  </script>
  <style>
    body {
      background: linear-gradient(180deg,#f6f7fb,#f3f5fb); /* Light, soft purple background to match screenshot */
      color: #111827;
      font-family: 'Segoe UI', Arial, sans-serif;
      margin: 0 auto;
      padding: 24px 18px;
      min-height: 100vh;
      /* Constrain overall layout width to 2400px and center it */
      max-width: 2400px;
    }
    h2 {
      text-align: center;
      font-size: 2.2rem;
      margin: 2rem 0 1rem 0;
      font-weight: bold;
    }
    /* Title parts so we can control stacking on very small screens */
    .title-line1, .title-line2 { display:inline-block; white-space:nowrap; }
    .metrics {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 1.5rem;
      margin-bottom: 2rem;
    }
    .metric-card {
      background: #ffffff;
      border-radius: 8px;
      padding: 14px 16px;
      min-width: 160px;
      text-align: left;
      font-size: 0.95rem;
      box-shadow: 0 6px 18px rgba(17,24,39,0.06);
      border: 1px solid rgba(15,23,42,0.04);
      flex: 1 1 220px;
      display:flex;flex-direction:column;justify-content:center;gap:6px;color:#0b1220
    }
    .kpi-title{ font-size:13px;color:#6b7280;margin-bottom:0 }
    .kpi-number{ font-size:26px;font-weight:800;color:#0b1220 }
    .kpi-delta{ font-size:12px;color:#10b981;margin-top:6px }
    .charts {
      display: flex;
      flex-wrap: wrap;
      gap: 2rem;
      justify-content: center;
      margin-bottom: 2rem;
    }
    /* Section wrapper to clearly group dashboard areas */
    .section {
      background: #ffffff;
      border-radius: 12px;
      padding: 12px 14px;
      margin-bottom: 18px;
      border: 1px solid rgba(15,23,42,0.04);
      box-shadow: 0 8px 20px rgba(17,24,39,0.04);
    }
    /* Slightly different background for filter strip so controls stand out */
    .filters { background: linear-gradient(180deg,#fbfdff,#f7fbfc); padding:12px 14px; border-radius:10px; border:1px solid rgba(15,23,42,0.04); box-shadow: 0 6px 14px rgba(17,24,39,0.03); }
    /* Metrics area as a card group */
    .metrics { background: linear-gradient(180deg,#ffffff,#fbfdff); padding:14px; border-radius:12px; border:1px solid rgba(15,23,42,0.04); box-shadow: 0 8px 24px rgba(17,24,39,0.04); }
    /* Chart grid wrapper */
    .charts-wrapper { width: 100%; display:flex; flex-direction:column; gap:12px; }
    .charts .chart-container { background: #ffffff; border:1px solid rgba(15,23,42,0.04); }
    /* Section headers */
    .section-title { font-weight:800; color:#0b1220; margin:6px 4px 12px 4px; font-size:15px }
    .chart-container {
      background: #ffffff;
      border-radius: 10px;
      padding: 12px 14px 18px 14px;
      margin-bottom: 1rem;
      /* Default chart card width (desktop will use wider via media query) */
      width: 420px;
      min-width: 280px;
      color:#0b1220;
      border: 1px solid rgba(15,23,42,0.04);
      box-shadow: 0 8px 24px rgba(17,24,39,0.04);
    }
    /* Outer white wrapper to limit the white background area to max 1800px */
    .page-white {
      background: #ffffff;
      border-radius: 14px;
      padding: 18px 20px 28px 20px;
      margin: 12px auto;
      box-shadow: 0 10px 30px rgba(17,24,39,0.04);
      max-width: 2400px;
      width: calc(100% - 40px);
    }
    .chart-title{ font-weight:700;color:#0b1220;font-size:14px;margin:6px 8px }
    .filters {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      justify-content: center;
      margin-bottom: 2rem;
    }
    .filters select, .filters input {
      font-size: 0.95rem;
      padding: 0.6rem 0.75rem;
      border-radius: 8px;
      border: 1px solid rgba(15,23,42,0.06);
      margin-right: 0.5rem;
      background: #fff;
      color:#0b1220
    }
    /* make selects show a dropdown caret and higher contrast */
     /* make selects readable across platforms: white background with dark text so dropdown
       overlay (native) shows visible labels; keep a subtle caret spacing */
     .filters select{ background:#fff; color:#0b1220; padding-right:28px }
     .filters select option{ color: #0b1220; }
     .filters select::-ms-expand{ display:none }
    .filter-chip{ display:inline-flex; align-items:center; gap:8px; background:#1e2830; color:#fff; padding:6px 8px; border-radius:16px; margin:4px; font-size:13px }
    .filter-chip button{ background:transparent;border:none;color:#fff;margin-left:6px;cursor:pointer }
    .export-btn {
      background: linear-gradient(90deg,#0f62fe,#0066ff);
      color: #fff;
      border: none;
      border-radius: 8px;
      padding: 8px 12px;
      font-size: 0.92rem;
      font-weight: 700;
      cursor: pointer;
      margin-bottom: 1rem;
      box-shadow: 0 6px 18px rgba(2,6,23,0.08);
    }
    .staff-btn {
      display:inline-block;
      background: #1e73d1;
      color: #fff;
      padding: 10px 14px;
      border-radius: 8px;
      text-decoration:none;
      font-weight:700;
      font-size:14px;
      text-align:center;
      box-shadow:0 6px 18px rgba(0,0,0,0.25);
    }
    table {
      /* Expand table to use more horizontal space while capping max width */
      /* Use calc to respect small internal paddings while filling the white area */
      width: 100%;
      max-width: none;
      margin: 1.5rem auto;
      background: #ffffff;
      border-radius: 8px;
      color: #0b1220;
      font-size: 0.88rem;
      border-collapse: collapse;
      overflow-x: auto;
      box-shadow: 0 10px 30px rgba(17,24,39,0.04);
      border: 1px solid rgba(15,23,42,0.04);
    }
    th, td {
      padding: 0.65rem 0.6rem;
      border-bottom: 1px solid rgba(15,23,42,0.04);
      text-align: left;
      color: #0b1220;
    }
    th {
      background: #f3f6f9;
      font-weight: 700;
      color: #0b1220;
    }
    tr:last-child td {
      border-bottom: none;
    }
    @media (max-width: 800px) {
      .charts { flex-direction: column; align-items: center; }
      .chart-container { width: 95vw; min-width: 200px; }
      table { font-size: 0.9rem; }
    }
    /* Additional mobile optimizations */
    @media (max-width: 520px) {
      /* Keep metrics compact and touch-friendly */
      .metrics { gap: 0.4rem; padding: 6px; }
      .metric-card { padding: 8px 10px; }
      .kpi-number { font-size: 18px }
      .kpi-title { font-size: 11px }

      /* Simplify charts shown on very small screens to reduce vertical length:
         show only core items (gauge + 일자 추이 + 과목 분포 + 활동 유형)
         hide secondary charts to avoid heavy scrolling */
      .charts { display:flex; flex-direction:column; gap:10px; }
      .charts .chart-container { width: 100% !important; min-width:0 !important; }
      /* Hide less critical charts on very small screens */
      .charts .chart-container:nth-child(n+4) { display:none; }

      /* Legends can be long; make them horizontally scrollable instead of tall */
      .legend-scroll { max-height:120px; overflow-y:auto; }

      /* Tables: allow horizontal scrolling and reduce padding */
      .table-wrapper { padding:8px; }
      table { width: 100% !important; max-width: 100% !important; font-size:0.68rem; }
      thead th, tbody td { padding: 0.16rem 0.14rem; }
      .td-inline { font-size:0.62rem }

      /* Make pagination buttons larger for touch */
      .pagination button { padding:8px 10px; font-size:0.82rem; }

      /* Reduce modal max-width to fit mobile nicely */
      .modal-content { max-width: 94%; padding:12px; }
    }
    /* table header / body refinements for better contrast, sticky header and hover */
    table { border-radius: 12px; overflow: hidden; box-shadow: 0 10px 30px rgba(17,24,39,0.06); }
    thead { background: #f3f6f9; }
    thead th { color: #0b1220; padding: 0.6rem 0.6rem; border-bottom: 1px solid rgba(15,23,42,0.04); position: sticky; top: 0; z-index: 2; }
    tbody td { background: #ffffff; color: #0b1220; padding: 0.28rem 0.5rem; vertical-align: middle; }
    tbody tr:hover td { background: #f7fbfc; }
    .detail-btn{ background:#1e73d1;border:none;color:#fff;padding:3px 6px;border-radius:8px;cursor:pointer;font-weight:700;font-size:0.8rem }
    /* compact detail column - reduce horizontal padding and button size */
    table tbody td:last-child{ padding:0.08rem 0.12rem; text-align:center; width:1%; white-space:nowrap }
    table tbody td:last-child .detail-btn{ padding:2px 4px; font-size:0.78rem; min-width:36px }
    /* modal for detail view */
    .modal { position:fixed; left:0; top:0; right:0; bottom:0; display:none; align-items:center; justify-content:center; background:rgba(2,6,23,0.45); z-index:9999 }
    .modal-content { background: #ffffff; color:#0b1220; border-radius:10px; width:90%; max-width:820px; padding:18px; box-shadow:0 12px 40px rgba(17,24,39,0.06); }
    .modal-header{ display:flex; justify-content:space-between; align-items:center; gap:12px }
    .modal-close{ background:transparent;border:0;color:#374151;font-size:22px;cursor:pointer }
    .modal-body{ margin-top:12px; font-size:14px; color:#374151 }
    .modal-row{ display:flex; gap:12px; margin-bottom:8px }
    .modal-row .label{ min-width:110px; color:#6b7280 }
    .chart-legend{ margin-top:8px; display:flex; flex-wrap:wrap; gap:8px; align-items:center }
    .legend-item{ display:flex; align-items:center; gap:8px; padding:6px 8px; background:#ffffff; border:1px solid rgba(15,23,42,0.04); border-radius:8px }
    /* Scrollable legend variant (used for activities list) */
    .legend-scroll{ display:block; max-height:260px; overflow-y:auto; padding:6px; box-sizing:border-box }
    .legend-scroll .legend-item{ display:flex; width:100%; margin-bottom:8px }
    .legend-swatch{ width:12px; height:12px; border-radius:3px; display:inline-block }
    .legend-label{ font-size:13px; color:#0b1220 }
    .legend-count{ font-size:12px; color:#6b7280; margin-left:6px }
    /* clamp table cell content to max 2 lines to avoid very tall rows */
    .td-clamp{ display:-webkit-box; line-clamp:2; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; text-overflow:ellipsis; white-space:normal; line-height:0.98rem; max-height:1.98rem }
    /* horizontal single-line clamp for short columns */
    .td-inline{ white-space:nowrap; overflow:hidden; text-overflow:ellipsis; font-size:0.72rem }
    @media (max-width:520px) {
      /* mobile overrides (important) matching 430px total */
      table thead th:nth-child(1), table tbody td:nth-child(1) { width: 60px !important; }
      table thead th:nth-child(2), table tbody td:nth-child(2) { width: 78px !important; }
      table thead th:nth-child(3), table tbody td:nth-child(3) { width: 110px !important; }
      table thead th:nth-child(4), table tbody td:nth-child(4) { width: 70px !important; }
      table thead th:nth-child(5), table tbody td:nth-child(5) { width: 62px !important; }
      table thead th:nth-child(6), table tbody td:nth-child(6) { width: 50px !important; min-width:50px; max-width:50px !important; }
      thead th, tbody td { box-sizing: border-box; }
    }
    /* At very small widths show metric cards two-per-row (target: 435px) */
    @media (max-width:435px) {
      .metrics { gap: 0.6rem; padding: 0 6px; justify-content:space-between; align-items:stretch; }
      /* Force two-up grid: override earlier min-width/flex rules so cards appear 2-per-row */
      .metric-card { flex: 0 0 50% !important; max-width: calc(50% - 0.6rem) !important; min-width: 0 !important; box-sizing:border-box; padding:10px 12px; }
      .metric-card .kpi-number{ font-size:20px }
      .metric-card .kpi-title{ font-size:12px }
      /* Stack the dashboard title into two explicit lines at this width */
      .title-line1, .title-line2 { display:block; width:100%; text-align:center; white-space:nowrap; }
      h2 { font-size:1.6rem; line-height:1.05; margin-top:1.2rem; }
    }
    /* PIN overlay */
    .pin-overlay{ position:fixed; left:0; top:0; right:0; bottom:0; background:rgba(2,12,27,0.95); display:flex; align-items:center; justify-content:center; z-index:10000; }
    .pin-box{ background:linear-gradient(180deg,#072432,#041827); padding:24px;border-radius:12px;box-shadow:0 12px 40px rgba(0,0,0,0.6); color:#eaf6ff; width:320px; max-width:90%; text-align:center }
    .pin-box h3{ margin:0 0 10px 0 }
    .pin-input{ font-size:22px; padding:10px 12px; width:100%; text-align:center; border-radius:8px; border:1px solid rgba(255,255,255,0.06); background:rgba(255,255,255,0.02); color:#fff }
    .pin-btn{ margin-top:12px; padding:10px 14px; border-radius:8px; border:none; background:#1e73d1; color:#fff; font-weight:700; cursor:pointer }
    .pin-error{ color:#ff8b8b; margin-top:8px; font-size:13px }
    /* container to center content like the screenshot */
    .container { max-width:2200px;margin:0 auto;padding:8px; }
    .top-card { background:#ffffff;border-radius:14px;padding:18px 22px;margin:0 auto 18px;box-shadow:0 12px 30px rgba(17,24,39,0.06); border:1px solid rgba(15,23,42,0.04); }
    .top-actions { display:flex;gap:12px;align-items:center;justify-content:center;margin-bottom:8px }
    .primary-btn{ background:#0b63d6;color:#fff;padding:10px 14px;border-radius:10px;border:none;font-weight:800;cursor:pointer }
    .secondary-btn{ background:#fff;color:#0b1220;padding:8px 12px;border-radius:10px;border:1px solid rgba(15,23,42,0.06);font-weight:700;cursor:pointer }
  </style>
</head>
<body>
  <div class="page-white">
    <div id="cmass-debug" style="position:fixed;right:12px;top:80px;background:rgba(0,0,0,0.78);color:#fff;padding:8px;font-size:12px;z-index:99999;border-radius:8px;max-width:360px;max-height:60vh;overflow:auto;display:none;box-shadow:0 6px 18px rgba(0,0,0,0.6)"></div>
  <!-- PIN gate overlay: requires 4-digit PIN to view dashboard -->
  <div id="pinOverlay" class="pin-overlay" style="display:none">
    <div class="pin-box">
      <h3>관리자 PIN 입력</h3>
      <div style="font-size:13px;color:#bfe8ff;margin-bottom:8px">4자리 PIN을 입력하세요</div>
      <input id="pinInput" class="pin-input" type="password" inputmode="numeric" maxlength="4" placeholder="●●●●" />
      <div style="display:flex;gap:8px;justify-content:center;margin-top:10px"><button id="pinSubmit" class="pin-btn">입력</button><button id="pinClear" class="pin-btn" style="background:#666">지우기</button></div>
      <div id="pinError" class="pin-error" style="display:none">PIN이 올바르지 않습니다</div>
    </div>
  </div>
  <div class="container">
    <div class="top-card">
      <div style="text-align:center;margin-bottom:6px">
        <h2 style="margin:0;font-size:1.8rem;color:#0b1220">씨마스 영업 관리자 대시보드</h2>
      </div>
      <!-- quick actions and per-user summary removed per request -->
    </div>
    <div class="section">
    <div class="section-title">핵심 KPI</div>
    <div class="metrics">
    <div class="metric-card">
      <div class="kpi-title">이번 주 영업 기록</div>
      <div class="kpi-number" id="metric1">0</div>
      <div class="kpi-date" id="metric1_date" style="font-size:11px;color:#9ca3af;margin-top:6px">기준일: -</div>
      <div class="kpi-delta" id="delta1">+0%</div>
      <div style="font-size:12px;color:#6b7280;margin-top:6px" id="metric1_week">주간: -</div>
      <div style="font-size:12px;color:#6b7280;margin-top:2px" id="metric1_month">월간: -</div>
    </div>
    <div class="metric-card">
      <div class="kpi-title">방문 학교</div>
      <div class="kpi-number" id="metric2">0</div>
      <div class="kpi-date" id="metric2_date" style="font-size:11px;color:#9ca3af;margin-top:6px">기준일: -</div>
      <div class="kpi-delta" id="delta2">—</div>
      <div style="font-size:12px;color:#6b7280;margin-top:6px" id="metric2_week">주간: -</div>
      <div style="font-size:12px;color:#6b7280;margin-top:2px" id="metric2_month">월간: -</div>
    </div>
    <div class="metric-card">
      <div class="kpi-title">연락처 확보 교사</div>
      <div class="kpi-number" id="metric3">0</div>
      <div class="kpi-date" id="metric3_date" style="font-size:11px;color:#9ca3af;margin-top:6px">기준일: -</div>
      <div class="kpi-delta" id="delta3">—</div>
      <div style="font-size:12px;color:#6b7280;margin-top:6px" id="metric3_week">주간: -</div>
      <div style="font-size:12px;color:#6b7280;margin-top:2px" id="metric3_month">월간: -</div>
    </div>
    <div class="metric-card">
      <div class="kpi-title">출입불가 학교(평균)</div>
      <div class="kpi-number" id="metric4">0</div>
      <div class="kpi-date" id="metric4_date" style="font-size:11px;color:#9ca3af;margin-top:6px">기준일: -</div>
      <div class="kpi-delta" id="delta4">—</div>
      <div style="font-size:12px;color:#6b7280;margin-top:6px" id="metric4_week">주간: -</div>
      <div style="font-size:12px;color:#6b7280;margin-top:2px" id="metric4_month">월간: -</div>
    </div>
  </div>
  <!-- KPI targets summary (overall + per-staff) -->
  <div id="kpiTargets" style="margin-top:12px"></div>
  </div>
  <!-- 담당자 빠른 이동 버튼: 각 담당자의 front 페이지로 이동 -->
  <div style="text-align:center;margin-bottom:18px">
    <div style="display:inline-flex;gap:10px;flex-wrap:wrap;justify-content:center">
  <!-- quick staff buttons removed per user request -->
    </div>
  </div>
  <div class="section">
    <div class="section-title">필터</div>
    <div class="filters">
    <select id="filterUser">
      <option value="">영업사원 전체</option>
      <option value="SongHoonjae">송훈재</option>
      <option value="LimJunho">임준호</option>
      <option value="ChoYounghwan">조영환</option>
    </select>
    <select id="filterSubject" style="padding:0.65rem;border-radius:0.7rem;border:none;min-width:160px">
    <option value="">과목 전체</option>
      <option value="">지역 전체</option>
      <option>서울특별시</option><option>부산광역시</option><option>경기도</option>
      <!-- ... 기타 지역 ... -->
    </select>
    <select id="filterEstablish">
      <option value="">설립구분 전체</option>
      <option>공립</option>
      <option>사립</option>
    </select>
    <select id="filterFavor" style="min-width:140px">
      <option value="">우호도 전체</option>
      <option value="promoter">우호(반응좋음)</option>
      <option value="passive">중립(반응보통)</option>
      <option value="detractor">부정(반응나쁨)</option>
    </select>
    <select id="filterSchoolLevel">
      <option value="">학교급 전체</option>
      <option>초등</option>
      <option>중등</option>
      <option>고등</option>
    </select>
    <!-- Removed numeric filters for students/activities/materials per request -->
    <input type="text" id="filterSchool" list="schoolList" placeholder="학교명 검색">
    <datalist id="schoolList"></datalist>
    <input type="text" id="filterTeacher" list="teacherList" placeholder="선생님 이름 검색">
    <datalist id="teacherList"></datalist>
    <input type="date" id="filterStart">
    <input type="date" id="filterEnd">
    <button class="export-btn" id="exportBtn">Excel 내보내기</button>
    <button class="export-btn" id="toggleCsvCols" style="background:#2a5298;margin-left:6px">CSV 컬럼 선택</button>
    <button class="export-btn" id="resetFiltersBtn" style="background:#6b7280;margin-left:6px">초기화</button>
    <div id="csvColsPanel" style="display:none;position:absolute;background:#111;padding:10px;border-radius:8px;border:1px solid #333;color:#fff;margin-top:40px;z-index:999">
      <div style="max-height:220px;overflow:auto;"> 
... (파일의 나머지 내용은 원본과 동일하게 저장됨)
