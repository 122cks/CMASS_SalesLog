{
  "functions": {
    "source": "functions"
  },
  
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "rewrites": [
      { "source": "/schoolreport", "destination": "/schoolreport.html" },
      { "source": "/schoolreport/", "destination": "/schoolreport.html" },
      { "source": "/meeting", "destination": "/meeting.html" },
      { "source": "/meeting/", "destination": "/meeting.html" },
      { "source": "/input", "destination": "/input.html" },
      { "source": "/input/", "destination": "/input.html" },
      { "source": "/front", "destination": "/front.html" },
      { "source": "/front/", "destination": "/front.html" },
      { "source": "/report", "destination": "/report.html" },
      { "source": "/report/", "destination": "/report.html" },
      { "source": "/dashboard", "destination": "/dashboard.html" },
      { "source": "/dashboard/", "destination": "/dashboard.html" },
      { "source": "/api/**", "function": { "functionId": "api", "region": "us-central1" } },
      { "source": "/", "destination": "/index.html" },
      { "source": "**", "destination": "/index.html" }
    ]
  }
}
