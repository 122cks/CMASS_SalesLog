// Simple Firestore rules for internal use
// Allows authenticated users to write visits; denies reads/writes to unauthenticated.
// For company-internal use you may relax auth but this is safer.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Primary collection used by the app (meeting/report/front)
    match /visit_entries/{docId} {
      // 읽기는 모두 허용 (schoolinfo.html에서 사용), 쓰기는 인증 필요
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /visits/{docId} {
      allow create: if request.auth != null && request.resource.data.keys().hasAll(['created_at','payload']);
      allow read: if true; // schoolinfo.html에서 사용
      allow update, delete: if false; // do not allow updates/deletes from clients
    }
    
    // Teachers DB - 내부 사용, 인증 없이 허용
    match /teachers/{teacherId} {
      allow read, write: if true; // 내부 시스템이므로 전체 허용
    }

    // 채택현황 - 내부 사용, 인증 없이 허용
    match /adoption_status/{docId} {
      allow read, write: if true; // 내부 시스템이므로 전체 허용
    }
  }
}
